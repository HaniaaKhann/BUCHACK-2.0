{
  "name": "app-root",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel --if-present typecheck",
    "test": "pnpm -r --parallel --if-present test",
    "build": "pnpm -r --if-present build",
    "data:inspect": "pnpm --filter @app/simulator data:inspect",
    "data:map": "pnpm --filter @app/simulator data:map",
    "data:import": "pnpm --filter @app/simulator data:import",
    "demo:reset": "pnpm --filter @app/worker demo:reset",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down -v"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0"
  }
}
